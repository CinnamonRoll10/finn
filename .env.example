# Pick ONE model provider. With none of these set, FINN uses the Claude Code CLI
# (`claude`) if it is installed and logged in; with nothing at all it still runs
# with rule-based triage and numbers-only research.
#ANTHROPIC_API_KEY=sk-ant-...
#GEMINI_API_KEY=...

# Optional overrides
#FINN_LLM_PROVIDER=auto        # auto | anthropic | gemini | claude-cli | none
#FINN_FAST_MODEL=claude-haiku-5-5
#FINN_SMART_MODEL=claude-opus-5-5
#FINN_DATA_DIR=./data          # cache + settings location
#FINN_NO_WARM=1                # disable the 15-minute background digest refresh
